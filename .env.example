# Copy to .env in the repo root and fill in. Never commit .env.
# If the DB password contains @ : / # % or spaces, URL-encode it (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/airtel_sync
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=480

# The only employee account (created/updated at backend startup; password stored hashed)
EMPLOYEE_EMAIL=CHANGE_ME@yourcompany.example
EMPLOYEE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
EMPLOYEE_NAME=Airtel Vyapaar Connect Staff

# LLM (configurable). Without a working key the advisor runs in "Basic mode".
LLM_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash

# KYC prototype settings
KYC_REFERENCE_DATE=2026-07-15
KYC_ADDRESS_PROOF_MAX_DAYS=90
UPLOAD_DIR=backend/uploads
UPLOAD_RETENTION_DAYS=7
MAX_UPLOAD_MB=5
MAX_AUDIO_KB=2048
DATA_DIR=6ae1873397bc1_digital/YTL_TrackA_Udyam_Digital_Data
CORS_ORIGINS=http://localhost:3000
